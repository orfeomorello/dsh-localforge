{
  "name": "dsh-localforge",
  "version": "0.1.0",
  "description": "High-performance LM Studio (and any OpenAI/Anthropic-compatible local server) chat-completions adapter for DeepSeek Harness, with live discovery, auto-load, model fallback, concurrency control, Prometheus metrics, and a permissive vision-aware partner adapter.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "lm-studio",
    "llm",
    "openai-compatible",
    "local-llm",
    "anthropic-compatible",
    "cordis",
    "prometheus"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "homepage": "https://github.com/orfeomorello/dsh-localforge",
  "bugs": "https://github.com/orfeomorello/dsh-localforge/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orfeomorello/dsh-localforge.git"
  },
  "authors": [
    {
      "url": "https://github.com/orfeomorello"
    }
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "scripts/build.mjs",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "npm run build && node --test test/package-smoke.test.mjs",
    "lint": "eslint src test",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run lint && npm run test:package"
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0",
    "gpt-tokenizer": "^2.5.0",
    "prom-client": "^15.1.3",
    "pino": "^9.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.3",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-attachment": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-timeout": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "msw": "^2.6.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
