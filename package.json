{
  "name": "dsh-localforge",
  "version": "0.1.0",
  "description": "High-performance LM Studio (and any OpenAI/Anthropic-compatible local server) chat-completions adapter for DeepSeek Harness, with live discovery, auto-load, model fallback, concurrency control, Prometheus metrics, and a permissive vision-aware partner adapter.",
  "type": "module",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "lm-studio",
    "llm",
    "openai-compatible",
    "local-llm",
    "anthropic-compatible",
    "cordis",
    "prometheus"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "homepage": "https://github.com/orfeomorello/dsh-localforge",
  "bugs": "https://github.com/orfeomorello/dsh-localforge/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orfeomorello/dsh-localforge.git"
  },
  "authors": [
    {
      "url": "https://github.com/orfeomorello"
    }
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "build": "tsc -b tsconfig.json --emitDeclarationOnly",
    "prepublishOnly": "npm run typecheck && npm run test && npm run lint"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../vendor/cordis",
    "@deepseek-ai/cordis-plugin-include": "link:../../vendor/include",
    "@deepseek-ai/cordis-plugin-loader": "link:../../vendor/loader",
    "@deepseek-ai/dsh-attachment": "link:../../packages/attachment/attachment",
    "@deepseek-ai/dsh-credentials": "link:../../packages/credentials/credentials",
    "@deepseek-ai/dsh-invariants": "link:../../packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-launch-environment": "link:../../packages/util/launch-environment",
    "@deepseek-ai/dsh-llm": "link:../../packages/llm/llm",
    "@deepseek-ai/dsh-settings": "link:../../packages/settings/settings",
    "@deepseek-ai/dsh-timeout": "link:../../packages/util/timeout",
    "@deepseek-ai/dsh-util-values": "link:../../packages/util/values",
    "@deepseek-ai/schemastery": "link:../../vendor/schemastery",
    "eventsource-parser": "^3.1.0",
    "gpt-tokenizer": "^2.5.0",
    "prom-client": "^15.1.3",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "msw": "^2.6.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}